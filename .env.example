# Copy this file to .env.local for local development.
#
# Postgres connection string. Get this from your Supabase project:
# Project Settings -> Database -> Connection string -> URI.
#
# For local dev and running migrations, use the *direct* connection
# (port 5432). On Vercel, prefer the *transaction pooler* connection
# (port 6543, "Transaction" mode) since serverless functions open many
# short-lived connections.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
